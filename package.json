{
  "name": "hazelcare-ops",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:circular": "madge --circular --extensions ts,tsx ./src",
    "prebuild": "npm run check:circular",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@tailwindcss/vite": "^4.2.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "2.8.2",
    "docx": "^9.6.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.577.0",
    "mammoth": "1.13.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.8.0",
    "resend": "^6.17.2",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "6.2.6",
    "globals": "^17.4.0",
    "madge": "^8.0.0",
    "playwright": "^1.60.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "zod": "4.6.6"
  }
}
